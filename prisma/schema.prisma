generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ShippingStatus {
  DIPROSES
  DIKIRIM
  DALAM_PERJALANAN
  SELESAI
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  address      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  addresses    Address[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("Rumah")
  recipientName String
  phone         String
  province      String
  city          String
  district      String
  postalCode    String
  fullAddress   String   @db.Text
  notes         String?  @db.Text
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

model Product {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  price       Decimal        @db.Decimal(12, 2)
  oldPrice    Decimal?       @db.Decimal(12, 2)
  discount    String?
  stock       Int            @default(0)
  category    String?
  collection  String?
  specs       String[]
  imageUrl    String
  isNewDrop   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orderItems  OrderItem[]
  images      ProductImage[]
  sizes       ProductSize[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  order     Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      String
  stock     Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Banner {
  id          String   @id @default(cuid())
  tag         String?  
  title       String?  
  description String?  @db.Text
  imageUrl    String   
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id              String         @id @default(cuid())
  userId          String
  totalAmount     Decimal        @db.Decimal(12, 2)
  shippingAddress String         @db.Text
  trackingNumber  String?        @unique
  shippingStatus  ShippingStatus @default(DIPROSES)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payment         Payment?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  provider         String        @default("MIDTRANS")
  transactionToken String        @unique
  externalRefId    String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
